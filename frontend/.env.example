# Environment variables template
# Copy this file to .env and fill in your values

# API Base URL.
# In development this is read from here by Vite.
# In a Docker deployment, set the same variable on the CONTAINER: the
# entrypoint writes it into /config.js at startup, so it is applied without
# rebuilding the image.
VITE_API_BASE_URL=http://localhost:5000/api

# App Configuration
VITE_APP_TITLE=BoloChinese
VITE_APP_VERSION=1.0.0