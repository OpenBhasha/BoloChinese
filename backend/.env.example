# Environment variables template
# Copy this file to .env and fill in your values

NODE_ENV=development
PORT=5000

MONGODB_URI=yours
JWT_SECRET=123456
JWT_REFRESH_SECRET=123456
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

CLOUDINARY_CLOUD_NAME=yours
CLOUDINARY_API_KEY=yours
CLOUDINARY_API_SECRET=yours
# First admin, seeded automatically on server startup (idempotent).
# Leave blank to disable seeding. Set SEED_ADMIN=false to keep the
# credentials but skip the automatic seeding at boot.
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@bolo.com
ADMIN_PASSWORD=replace_with_a_strong_password
SEED_ADMIN=true
